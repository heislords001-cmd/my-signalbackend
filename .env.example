# Copy this file to a new file named .env and fill in the values. Never share .env with anyone.

# Your Supabase project (Settings > API). The service key is SECRET: it lives only on your VPS.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Price source. yahoo = free, works on Linux. (mt5 only on a Windows machine with MT5 installed.)
FEED=yahoo

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
