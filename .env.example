# Copy this file to a new file named .env and fill in the values. Never share .env with anyone.
# On Railway you do NOT use this file: you type these same names into Railway's Variables tab.

# Your Supabase project (Settings > API). The service key is SECRET.
# Leave both empty to run in LOCAL mode (signals go to Telegram and the data folder only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Price source. yahoo is free and works anywhere.
FEED=yahoo

# Telegram alerts (run: python telegram_setup.py to fill these in for you)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LOCAL mode only: also send signals from strategies that have not passed the backtest (clearly marked UNTESTED)
SEND_UNAPPROVED=yes
